APP_NAME=PVT Back Auth
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgresql+asyncpg://pvt:pvt@127.0.0.1:5432/pvt_auth
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
REDIS_URL=redis://127.0.0.1:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ENABLED=false
KAFKA_TOPIC_AUTH_EVENTS=auth.events

# Use a long random secret in production (>=32 chars)
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

REFRESH_COOKIE_NAME=pvt_refresh
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

PASSWORD_MIN_LENGTH=8
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_DEMO_MODE=true
OTP_DEMO_CODE=123456
INVITE_TOKEN_TTL_SECONDS=604800

RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_OTP_PER_MINUTE=3
ME_CACHE_TTL_SECONDS=20
MFA_ISSUER=TebNote

SEED_ON_STARTUP=true

KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_OTP_TEMPLATE=
KAVENEGAR_OTP_MESSAGE_TEMPLATE=TebNote code: {code}
KAVENEGAR_CREDENTIALS_MESSAGE_TEMPLATE=TebNote access\nEmail: {email}\nPassword: {password}\nLogin and change your password.
KAVENEGAR_TIMEOUT_SECONDS=15

# Leave merchant empty for local DEMO checkout (no real charge)
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_URL=http://127.0.0.1:8000/api/v1/subscriptions/zarinpal/callback
ZARINPAL_CURRENCY=IRR
